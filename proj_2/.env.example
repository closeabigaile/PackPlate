# Copy to .env and adjust. .env is gitignored.
POSTGRES_USER=packplate
POSTGRES_PASSWORD=packplate
POSTGRES_DB=packplate
# Host port for the db container. Change it (e.g. 5433) if a local Postgres
# already uses 5432, and use the same port in the URLs below.
POSTGRES_PORT=5432

# Used by the backend and ingestion when run outside Docker.
DATABASE_URL=postgresql://packplate:packplate@localhost:5432/packplate

# Ingestion write-stage tests use their own database on the same server; the
# tests create it if missing. Leave unset to skip database tests.
TEST_DATABASE_URL=postgresql://packplate:packplate@localhost:5432/packplate_test

# Accounts (M1). Set COOKIE_SECURE=1 when the site is served over HTTPS so the
# session cookie is never sent unencrypted; leave it unset for local http.
# COOKIE_SECURE=1
# How long a login lasts, in days.
SESSION_DAYS=30

# Ingestion: seconds between requests to the source sites (keep >= 1.0).
SCRAPE_DELAY=1.0
