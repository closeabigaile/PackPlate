# Copy to .env and adjust. .env is gitignored.
POSTGRES_USER=packplate
POSTGRES_PASSWORD=packplate
POSTGRES_DB=packplate
# Host port for the db container. Change it (e.g. 5433) if a local Postgres
# already uses 5432, and use the same port in the URLs below.
POSTGRES_PORT=5432

# Used by the backend and ingestion when run outside Docker.
DATABASE_URL=postgresql://packplate:packplate@localhost:5432/packplate

# Ingestion write-stage tests use their own database on the same server; the
# tests create it if missing. Leave unset to skip database tests.
TEST_DATABASE_URL=postgresql://packplate:packplate@localhost:5432/packplate_test

# Accounts (M1). Set COOKIE_SECURE=1 when the site is served over HTTPS so the
# session cookie is never sent unencrypted; leave it unset for local http.
# COOKIE_SECURE=1
# How long a login lasts, in days.
SESSION_DAYS=30

# Ingestion: seconds between requests to the source sites (keep >= 1.0).
SCRAPE_DELAY=1.0

# Dining assistant (M3). All optional; the values below are the defaults.
# ASSISTANT_ENABLED=true
# ASSISTANT_RATE_PER_MINUTE=10
# ASSISTANT_MAX_MESSAGE_CHARS=500
# On by default and safe to leave on: if a service can't be reached, the assistant
# quietly uses its built-in rules or shows straight-line distances. Set to false to
# stop using one.
# Read messages the rules can't with a local Ollama model (it only classifies).
# Needs Ollama running with the model pulled (`ollama pull qwen2.5:1.5b`); with
# no Ollama the rules answer instead.
# ASSISTANT_LLM_ENABLED=true
# ASSISTANT_LLM_URL=http://localhost:11434
# ASSISTANT_LLM_MODEL=qwen2.5:1.5b
# Look up a typed place that campus_places.json doesn't list, on OpenStreetMap's
# free search. Only the typed place is sent.
# ASSISTANT_GEOCODE_ENABLED=true
# ASSISTANT_GEOCODE_URL=https://nominatim.openstreetmap.org
# Driving distance and time from a place too far to walk from, on the free public
# OSRM server. Only coordinates are sent.
# ASSISTANT_ROUTING_ENABLED=true
# ASSISTANT_ROUTING_URL=https://router.project-osrm.org

# On start, the API brings a database on this machine (localhost or the Docker `db`
# service) up to date, so `alembic upgrade head` isn't needed after pulling. A shared
# or hosted database is never changed this way. Set to false to turn it off.
# MIGRATE_ON_START=true
